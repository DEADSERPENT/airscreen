<?xml version="1.0" encoding="utf-8"?>
<!--
  AirScreen TV "Stage and Shelf": spatial, monochrome, cinematic.
  Ready = floating hero over a shelf of glass cards. Pairing = full-bleed billboard. Connecting = lower third.
  Settings = card carousel + detail strip. Streaming = video with lower-third bars. 3D icons only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextureView
        android:id="@+id/videoTex"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===================== READY: the stage ===================== -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_canvas"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="26dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <com.airscreen.ui.AbstractBackground android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-48dp"
            android:layout_marginTop="-26dp"
            android:layout_marginEnd="-48dp"
            android:layout_marginBottom="-24dp" />

        <!-- top bar: brand left, nothing else competes with the stage -->
        <LinearLayout
            android:id="@+id/brandRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="AirScreen"
                android:src="@drawable/brand_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:text="AirScreen"
                android:textColor="@color/text_secondary"
                android:textFontWeight="600"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass_chip"
                android:fontFamily="@font/inter"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="TV"
                android:textColor="@color/text_secondary"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:background="@drawable/pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic3d_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:text="Settings"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- the stage: floating hero, giant headline, subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="230dp"
                android:layout_height="150dp"
                android:clipChildren="false">

                <ImageView
                    android:layout_width="230dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/hero_scene" />
            </FrameLayout>

            <TextView
                android:id="@+id/headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:text="Ready to connect"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="Choose this TV on your PC"
                android:textColor="@color/text_secondary"
                android:textFontWeight="400"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- the shelf: three floating cards -->
        <LinearLayout
            android:id="@+id/codeSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="44dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- card 1: pairing code -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="96dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.14"
                    android:text="PAIR KEY"
                    android:textColor="@color/text_tertiary"
                    android:textFontWeight="600"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/code1"
                        style="@style/CodeTile" />

                    <TextView
                        android:id="@+id/code2"
                        style="@style/CodeTile" />
                </LinearLayout>
            </LinearLayout>

            <!-- card 2: this TV -->
            <LinearLayout
                android:layout_width="290dp"
                android:layout_height="96dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic3d_network_wifi" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.14"
                        android:text="THIS TV"
                        android:textColor="@color/text_tertiary"
                        android:textFontWeight="600"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/text_primary"
                        android:textFontWeight="600"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/stepsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.02"
            android:text="Open AirScreen on your PC   ·   Enter this key   ·   Allow it here"
            android:textColor="@color/text_tertiary"
            android:textFontWeight="500"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- ===================== CONNECTING: lower third ===================== -->
    <FrameLayout
        android:id="@+id/connectLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_canvas"
        android:visibility="gone">

        <com.airscreen.ui.AbstractBackground android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="88dp"
            android:contentDescription="@null"
            android:src="@drawable/ic3d_network_wifi" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="72dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/connectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Connecting"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="56sp" />

            <TextView
                android:id="@+id/connectSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Securing the connection"
                android:textColor="@color/text_secondary"
                android:textFontWeight="400"
                android:textSize="22sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/connectTrack"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@drawable/progress_track">

            <View
                android:id="@+id/connectBar"
                android:layout_width="220dp"
                android:layout_height="4dp"
                android:background="@drawable/progress_bar" />
        </FrameLayout>
    </FrameLayout>

    <!-- ===================== PAIRING APPROVAL: billboard ===================== -->
    <FrameLayout
        android:id="@+id/pairLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone">

        <ImageView
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic3d_security_shield" />

        <LinearLayout
            android:id="@+id/pairPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="72dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.18"
                android:text="PAIRING REQUEST"
                android:textColor="@color/text_tertiary"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pairTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:text="This PC"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="wants to cast its screen to this TV."
                android:textColor="@color/text_secondary"
                android:textFontWeight="400"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:id="@+id/pairNote"
                android:maxWidth="470dp"
                android:text="Allow it only if you just started this on your PC."
                android:textColor="@color/text_tertiary"
                android:textFontWeight="400"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/pairVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:fontFeatureSettings="&quot;tnum&quot; 1"
                android:text=""
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="46sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/denyBtn"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:background="@drawable/pill_glass_btn"
                    android:fontFamily="@font/inter"
                    android:stateListAnimator="@null"
                    android:text="Deny"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="600"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/allowBtn"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/pill_white"
                    android:fontFamily="@font/inter"
                    android:stateListAnimator="@null"
                    android:text="Allow"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textFontWeight="600"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== STOP: lower-third bar over the video ===================== -->
    <FrameLayout
        android:id="@+id/stopLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/stopPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/dialog_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Stop streaming?"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="600"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Your PC will be disconnected from this TV."
                    android:textColor="@color/text_secondary"
                    android:textFontWeight="400"
                    android:textSize="17sp" />
            </LinearLayout>

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="120dp"
                android:layout_height="46dp"
                android:background="@drawable/pill_glass_btn"
                android:fontFamily="@font/inter"
                android:stateListAnimator="@null"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="16sp" />

            <Button
                android:id="@+id/keepBtn"
                android:layout_width="160dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/pill_white"
                android:fontFamily="@font/inter"
                android:stateListAnimator="@null"
                android:text="Keep watching"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textFontWeight="600"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== SETTINGS: shelf + detail strip ===================== -->
    <FrameLayout
        android:id="@+id/settingsLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_canvas"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="26dp"
        android:paddingEnd="48dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <com.airscreen.ui.AbstractBackground android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-48dp"
            android:layout_marginTop="-26dp"
            android:layout_marginEnd="-48dp"
            android:layout_marginBottom="-26dp" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:fontFamily="@font/inter"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textFontWeight="600"
            android:textSize="40sp" />

        <LinearLayout
            android:id="@+id/settingsClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:background="@drawable/pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="130dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Back"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- the shelf: tall cards you move along -->
        <LinearLayout
            android:id="@+id/shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardPaired"
                style="@style/ShelfCard">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic3d_devices" />

                <TextView
                    style="@style/ShelfTitle"
                    android:text="Paired PCs" />

                <TextView
                    android:id="@+id/cardPairedSub"
                    style="@style/ShelfSub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDiag"
                style="@style/ShelfCard"
                android:layout_marginStart="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic3d_logs" />

                <TextView
                    style="@style/ShelfTitle"
                    android:text="Diagnostics" />

                <TextView
                    style="@style/ShelfSub"
                    android:text="Decoder and network" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAbout"
                style="@style/ShelfCard"
                android:layout_marginStart="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic3d_about" />

                <TextView
                    style="@style/ShelfTitle"
                    android:text="About" />

                <TextView
                    android:id="@+id/cardAboutSub"
                    style="@style/ShelfSub" />
            </LinearLayout>
        </LinearLayout>

        <!-- detail strip under the shelf -->
        <LinearLayout
            android:id="@+id/detailPanel"
            android:layout_width="match_parent"
            android:layout_height="224dp"
            android:layout_gravity="bottom"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="18dp"
            android:paddingEnd="30dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailBody"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:lineSpacingMultiplier="1.18"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="400"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/detailBody2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:lineSpacingMultiplier="1.18"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="400"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_tertiary"
                android:textFontWeight="500"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== STREAMING: lower-third status ===================== -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/dialog_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hudIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic3d_audio_volume" />

        <TextView
            android:id="@+id/hudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_primary"
            android:textFontWeight="500"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>

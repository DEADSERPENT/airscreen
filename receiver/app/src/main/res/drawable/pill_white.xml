<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#BDBDC2" /><stroke android:width="4dp" android:color="#8E8E94" /><corners android:radius="100dp" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#FFFFFF" /><stroke android:width="4dp" android:color="#8E8E94" /><corners android:radius="100dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#D6D6DA" /><stroke android:width="0dp" android:color="#00000000" /><corners android:radius="100dp" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- pairing code: four tiles in a 2 x 2 grid inside the first shelf card -->
    <style name="CodeTile">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:background">@drawable/glass_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:fontFeatureSettings">"tnum" 1</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">····</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- settings shelf: tall floating cards -->
    <style name="ShelfCard">
        <item name="android:layout_width">188dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:background">@drawable/card_focusable</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ShelfTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="ShelfSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
